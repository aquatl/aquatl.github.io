---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout>
  <section aria-labelledby="intro">
    <p class="eyebrow">A personal notebook</p>

    <h1 id="intro">Learning how things work.</h1>

    <p class="muted">
      Notes on systems, security, and programming.
      A place for experiments, questions, and things worth remembering.
    </p>
  </section>

  <section id="writing" class="writing" aria-labelledby="writing-title">
    <p class="eyebrow">The notebook</p>
    <h2 id="writing-title">Writing</h2>

    {posts.length === 0 ? (
      <p class="muted">No posts yet. The first entry is on its way.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toISOString().slice(0, 10)}
            </time>

            <div>
              <a href={`${base}articles/${post.id}/`}>
                {post.data.title}
              </a>
              <p>{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .post-list {
    padding: 0;
    margin-top: 28px;
    list-style: none;
  }

  .post-list li {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 24px;
    padding-block: 22px;
    border-bottom: 1px solid var(--border);
  }

  .post-list time {
    padding-top: 4px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 13px;
  }

  .post-list a {
    font-size: 20px;
    font-weight: 500;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .post-list a:hover {
    text-decoration: underline;
  }

  .post-list p {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  @media (max-width: 540px) {
    .post-list li {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>