---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;

const date = post.data.date.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  wide={toc.length > 0}
>
  <div class:list={["article-layout", { "with-toc": toc.length > 0 }]}>
  {toc.length > 0 && (
    <aside class="post-toc">
      <nav class="toc-nav" aria-label="Table of contents">
        <p class="toc-title">Table of contents</p>

        <ul>
          {toc.map((heading) => (
            <li class:list={{ subsection: heading.depth === 3 }}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )}
  <article class="post">
    <a class="back" href={`${base}articles/`}>← All writing</a>

    <div class="post-heading">
      <time class="eyebrow" datetime={post.data.date.toISOString()}>
        {date}
      </time>

      <h1>{post.data.title}</h1>
      <p class="muted">{post.data.description}</p>

      {post.data.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </div>

    <div class="prose">
      <Content />
    </div>
  </article>
</div>
</BaseLayout>

<style>
  .post {
    min-width: 0;
    max-width: 720px;
    width: 100%;
    margin-inline: auto;
    overflow-wrap: anywhere;
  }
  
  .back {
    font-family: var(--mono);
    font-size: 13px;
    text-decoration: none;
  }

  .post-heading {
    margin-block: 40px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 0;
    list-style: none;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 16px;
  }

  .prose {
    line-height: 1.85;
  }

  .prose :global(h2) {
    margin-top: 2.5em;
  }

  .prose :global(h3) {
    margin-top: 2em;
  }

  .prose :global(li) {
    margin-block: 8px;
  }

  .prose :global(pre) {
    padding: 22px;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 17px;
    line-height: 1.65;
  }

  .prose :global(code) {
    font-family: var(--mono);
  }

  .prose :global(:not(pre) > code) {
    padding: 2px 5px;
    background: #1c2b27;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-left: 22px;
    border-left: 2px solid var(--accent);
    color: var(--muted);
  }

  .prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin-block: 28px;
  }

  .prose :global(hr) {
    margin-block: 40px;
    border: 0;
    border-top: 1px solid var(--border);
  }
  .article-layout {
  max-width: 980px;
  margin-inline: auto;
}

.article-layout.with-toc {
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 40px;
  align-items: start;
}

.post-toc {
  position: sticky;
  top: 24px;
  max-height: calc(100dvh - 48px);
  overflow-y: auto;
}

.toc-nav {
  display: block;
  font-size: 13px;
}

.toc-title {
  margin: 0 0 16px;
  color: var(--text);
  font-weight: 600;
}

.toc-nav ul {
  margin: 0;
  padding: 0;
  list-style: none;
  border-left: 1px solid var(--border);
}

.toc-nav a {
  display: block;
  padding: 8px 14px;
  color: var(--muted);
  line-height: 1.5;
  overflow-wrap: anywhere;
  text-decoration: none;
}

.toc-nav a:hover,
.toc-nav a:focus-visible {
  color: var(--accent);
}

.toc-nav .subsection a {
  padding-left: 28px;
  font-size: 15px;
}

.prose :global(h2),
.prose :global(h3) {
  scroll-margin-top: 24px;
}

@media (max-width: 900px) {
  .article-layout.with-toc {
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }

  .post-toc {
    position: static;
    max-height: none;
  }
}
</style>